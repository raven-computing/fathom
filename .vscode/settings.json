{
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true,
  "python.testing.unittestArgs": [
    "--verbose",
    "--top-level-directory",
    "${workspaceFolder}",
    "--start-directory",
    "./tests/unit",
    "--pattern",
    "test_*.py"
  ],
  "python.experiments.enabled": false,
  "pylint.enabled": true,
  "pylint.args": [
    "--source-roots",
    "${workspaceFolder}"
  ]
}
