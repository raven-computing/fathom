{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raven-computing.com/fathom/request-parcel-v1.schema.json",
  "title": "Client Request Parcel",
  "description": "A request made by a Fathom client to a Fathom server.",
  "type": "object",
  "properties": {
    "action": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "object",
          "properties": {
            "identifier": {
              "type": "string"
            },
            "isLatest": {
              "type": "boolean"
            }
          },
          "required": ["identifier"]
        }
      },
      "required": ["identifier"]
    },
    "intent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "overwriteExisting": {
          "type": "boolean"
        }
      }
    },
    "deploymentAuthorization": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        }
      }
    },
    "package": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "data": {
          "type": "string"
        }
      },
      "required": ["format", "encoding", "data"]
    }
  }
}
